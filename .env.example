# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_PATH=./data/calendar.db

# JWT Secret (Change in production)
JWT_SECRET=your-secret-key-change-in-production

# OpenAI API (for AI features)
OPENAI_API_KEY=your-openai-api-key

# Email Configuration - Gmail Example
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback

# Email Configuration - Outlook/Microsoft
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REDIRECT_URI=http://localhost:3001/api/auth/outlook/callback

# Email Configuration - Generic IMAP/SMTP
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Microsoft Teams Integration (Optional)
TEAMS_CLIENT_ID=your-teams-client-id
TEAMS_CLIENT_SECRET=your-teams-client-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
